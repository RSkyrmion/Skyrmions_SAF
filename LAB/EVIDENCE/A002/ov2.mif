# MIF 2.1
# OV-2 : estados uniformes, SO o termo interlayer. Mede o fator 1/d (SL-2).
set pi [expr {4*atan(1.0)}]
set mu0 [expr {4*$pi*1e-7}]

Parameter anti 0        ;# 0 = paralelo (m1=+z,m2=+z) ; 1 = antiparalelo

set Ms   0.58e6
set d    0.4e-9
set Aint 2e-5           ;# A_int = 0.02 mJ/m^2 em J/m^2
set sig  [expr {-1.0*$Aint}]   ;# artigo: +Aint m1.m2  <->  OOMMF: sigma(1-m1.m2)

Specify Oxs_MultiAtlas:atlas [subst {
  atlas { Oxs_BoxAtlas { name bottom
      xrange {0 100e-9}  yrange {0 100e-9}  zrange {0 $d} } }
  atlas { Oxs_BoxAtlas { name spacer
      xrange {0 100e-9}  yrange {0 100e-9}  zrange {$d [expr {2*$d}]} } }
  atlas { Oxs_BoxAtlas { name top
      xrange {0 100e-9}  yrange {0 100e-9}  zrange {[expr {2*$d}] [expr {3*$d}]} } }
}]

Specify Oxs_PeriodicRectangularMesh:mesh [subst {
  cellsize {1e-9 1e-9 $d}
  atlas :atlas
  periodic xy
}]

Specify Oxs_LinearScalarField:zheight { vector {0 0 1}  norm 1.0 }

Specify Oxs_TwoSurfaceExchange:interlayer [subst {
  sigma $sig
  surface1 { atlas :atlas  region bottom  scalarfield :zheight
             scalarvalue $d           scalarside <= }
  surface2 { atlas :atlas  region top     scalarfield :zheight
             scalarvalue [expr {2*$d}] scalarside >= }
}]

if {$anti} { set mtop {0 0 -1} } else { set mtop {0 0 1} }

Specify Oxs_CGEvolve:evolve {}

Specify Oxs_MinDriver [subst {
  basename ov2_[expr {$anti ? "anti" : "par"}]
  evolver :evolve
  stopping_mxHxm 1e-8
  mesh :mesh
  Ms { Oxs_AtlasScalarField {
      atlas :atlas  default_value 0
      values { bottom $Ms   top $Ms }
  }}
  m0 { Oxs_AtlasVectorField {
      atlas :atlas  default_value {0 0 1}
      values { bottom {0 0 1}   top {$mtop} }
  }}
}]

Destination archive mmArchive
Schedule "Oxs_TwoSurfaceExchange:interlayer:Field" archive Stage 1
Schedule DataTable archive Stage 1
