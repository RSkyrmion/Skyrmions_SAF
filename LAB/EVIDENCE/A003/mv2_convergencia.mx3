// MV-2 (controle de convergencia) — o relax() do mumax3 convergiu mesmo?
// Identico ao mv2_par.mx3, mas salva o estado em TRES estagios:
// depois de relax(), depois de minimize(), e depois de minimize() de novo.
SetGridSize(100, 100, 2)
SetCellSize(1e-9, 1e-9, 0.4e-9)
SetPBC(2, 2, 0)
EnableDemag = false
Msat  = 0.58e6
Aex   = 15e-12
Ku1   = 0.6e6
anisU = vector(0, 0, 1)
defregion(1, zrange(-1e-9, 0))
defregion(2, zrange(0, 1e-9))
Dind.SetRegion(1,  3.05e-3)
Dind.SetRegion(2, -3.05e-3)
ext_InterDind(1, 2, 0)
ext_InterExchange(1, 2, -4e-15)
m.SetRegion(1, neelskyrmion( 1, -1).Transl(-5e-9, 0, 0))
m.SetRegion(2, neelskyrmion( 1,  1).Transl( 5e-9, 0, 0))
relax()
print("apos relax()      E_total =", E_total, "  maxTorque =", MaxTorque)
save(m)
minimize()
print("apos minimize()   E_total =", E_total, "  maxTorque =", MaxTorque)
save(m)
minimize()
print("apos minimize() 2 E_total =", E_total, "  maxTorque =", MaxTorque)
save(m)
