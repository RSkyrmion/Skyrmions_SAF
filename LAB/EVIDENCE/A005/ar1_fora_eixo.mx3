// AR-1 — o mumax3 preserva um estado que deveria ficar estatico?
// theta = 30 graus (FORA do eixo). O E003 mediu aqui deriva espuria de 7.1e-5 cm/s.
// CRITERIO: |v| < 0.05 cm/s. Se falhar, a A005 para e a A007 fica bloqueada.
SetGridSize(100, 100, 2)
SetCellSize(1e-9, 1e-9, 0.4e-9)
SetPBC(2, 2, 0)
EnableDemag = false
Msat = 0.58e6
Aex  = 15e-12
Ku1  = 0.6e6
anisU = vector(0, 0, 1)
defregion(1, zrange(-1e-9, 0))
defregion(2, zrange(0, 1e-9))
Dind.SetRegion(1,  3.05e-3)
Dind.SetRegion(2, -3.05e-3)
ext_InterDind(1, 2, 0)
ext_InterExchange(1, 2, -4e-15)
m.SetRegion(1, neelskyrmion( 1, -1).Transl(-4.330127019e-9, -2.5e-9, 0))
m.SetRegion(2, neelskyrmion( 1,  1).Transl( 4.330127019e-9,  2.5e-9, 0))
relax()
minimize()
minimize()
print("AR-1 relaxado  maxTorque =", MaxTorque, "  E_total =", E_total)
alpha = 0.02
autosave(m, 1e-9)
run(20e-9)
print("AR-1 fim       maxTorque =", MaxTorque)
