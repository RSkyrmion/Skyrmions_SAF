// A005R2 — cabecalho comum. Convencoes TODAS herdadas do MV-0 do A003 (medidas la).
SetGridSize(100, 100, 2)
SetCellSize(1e-9, 1e-9, 0.4e-9)
SetPBC(2, 2, 0)
EnableDemag = false
Msat = 0.58e6
Aex  = 15e-12
Ku1  = 0.6e6
anisU = vector(0, 0, 1)
defregion(1, zrange(-1e-9, 0))
defregion(2, zrange(0, 1e-9))
Dind.SetRegion(1,  3.05e-3)
Dind.SetRegion(2, -3.05e-3)
ext_InterDind(1, 2, 0)
ext_InterExchange(1, 2, -4e-15)
// Estagio F, degrau 4. Parte do ultimo checkpoint bem-sucedido.
m.LoadFile("LAB/EVIDENCE/A005R2/ck3.ovf")
print("F4rep inicio  MaxTorque =", MaxTorque)
MinimizerStop = 1e-10
minimize()
print("F4rep fim     MaxTorque =", MaxTorque, "  E_total =", E_total)
save(m)
