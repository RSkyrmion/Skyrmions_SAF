SetGridSize(100, 100, 2)
SetCellSize(1e-9, 1e-9, 0.4e-9)
SetPBC(2, 2, 0)
EnableDemag = false
Msat = 0.58e6
Aex  = 15e-12
Ku1  = 0.6e6
anisU = vector(0, 0, 1)
defregion(1, zrange(-1e-9, 0))
defregion(2, zrange(0, 1e-9))
Dind.SetRegion(1,  3.05e-3)
Dind.SetRegion(2, -3.05e-3)
ext_InterDind(1, 2, 0)
ext_InterExchange(1, 2, -4e-15)
// AC-2: CASAMENTO DE CONVERGENCIA — 1.0e-6 T, o mesmo do saf.cu desde o E002.
// Valor fixado no pre-registro, ANTES de qualquer corrida.
RelaxTorqueThreshold = 1e-6
MinimizerStop = 1e-9
m.SetRegion(1, neelskyrmion( 1, -1).Transl(-4.330127019e-9, -2.5e-9, 0))
m.SetRegion(2, neelskyrmion( 1,  1).Transl( 4.330127019e-9,  2.5e-9, 0))
relax()
print("AC-2 apos relax()    maxTorque =", MaxTorque)
minimize()
print("AC-2 apos minimize() maxTorque =", MaxTorque, "  E_total =", E_total)
alpha = 0.02
autosave(m, 1e-9)
run(20e-9)
