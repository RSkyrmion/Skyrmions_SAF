SetGridSize(100, 100, 2)
SetCellSize(1e-9, 1e-9, 0.4e-9)
SetPBC(2, 2, 0)
EnableDemag = false
Msat = 0.58e6
Aex  = 15e-12
Ku1  = 0.6e6
anisU = vector(0, 0, 1)
defregion(1, zrange(-1e-9, 0))
defregion(2, zrange(0, 1e-9))
Dind.SetRegion(1,  3.05e-3)
Dind.SetRegion(2, -3.05e-3)
ext_InterDind(1, 2, 0)
ext_InterExchange(1, 2, -4e-15)
// AC-0: CASAMENTO DE CONVERGENCIA — 1.0e-6 T, o mesmo do saf.cu desde o E002.
// Valor fixado no pre-registro, ANTES de qualquer corrida.
// AC-0: 1e-6 NAO e alcancavel (piso medido 1.4903e-5, float32). Casamento PARCIAL:
// sem RelaxTorqueThreshold (senao relax() nao retorna) e MinimizerStop no piso.
MinimizerStop = 1e-8
m.SetRegion(1, neelskyrmion( 1, -1).Transl(-5e-9, 0, 0))
m.SetRegion(2, neelskyrmion( 1,  1).Transl( 5e-9, 0, 0))
relax()
print("AC-3 apos relax()      maxTorque =", MaxTorque)
minimize()
print("AC-3 apos minimize()   maxTorque =", MaxTorque, "  E_total =", E_total)
save(m)
minimize()
print("AC-3 apos minimize() 2 maxTorque =", MaxTorque, "  E_total =", E_total)
save(m)
