// AC-0 (diagnostico) — qual e' o MENOR maxTorque que o mumax3 alcanca neste sistema?
// O pre-registro (§2) manda, se 1e-6 T nao for alcancavel, "reportar o melhor atingivel".
// SEM RelaxTorqueThreshold: relax() para pelo criterio proprio e nao trava.
SetGridSize(100, 100, 2)
SetCellSize(1e-9, 1e-9, 0.4e-9)
SetPBC(2, 2, 0)
EnableDemag = false
Msat = 0.58e6
Aex  = 15e-12
Ku1  = 0.6e6
anisU = vector(0, 0, 1)
defregion(1, zrange(-1e-9, 0))
defregion(2, zrange(0, 1e-9))
Dind.SetRegion(1,  3.05e-3)
Dind.SetRegion(2, -3.05e-3)
ext_InterDind(1, 2, 0)
ext_InterExchange(1, 2, -4e-15)
m.SetRegion(1, neelskyrmion( 1, -1).Transl(-5e-9, 0, 0))
m.SetRegion(2, neelskyrmion( 1,  1).Transl( 5e-9, 0, 0))
relax()
print("AC-0  apos relax()          maxTorque =", MaxTorque)
MinimizerStop = 1e-7
minimize()
print("AC-0  minimize(stop=1e-7)   maxTorque =", MaxTorque)
MinimizerStop = 1e-8
minimize()
print("AC-0  minimize(stop=1e-8)   maxTorque =", MaxTorque)
MinimizerStop = 1e-9
minimize()
print("AC-0  minimize(stop=1e-9)   maxTorque =", MaxTorque)
minimize()
print("AC-0  minimize(stop=1e-9) 2 maxTorque =", MaxTorque, "  E_total =", E_total)
save(m)
